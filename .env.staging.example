# The browser uses the same-origin Vercel proxy for Sanctum cookies.
VITE_API_BASE_URL=/
VITE_KPS_ENVIRONMENT=staging
KPS_BACKEND_ORIGIN=https://kps-api-staging.example.invalid
KPS_BACKEND_ENVIRONMENT=staging
# Non-secret comparison value used only to prevent staging from proxying production.
KPS_PRODUCTION_BACKEND_ORIGIN=https://kps-api.example.invalid
