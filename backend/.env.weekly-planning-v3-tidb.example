# Proposed local-only TiDB profile. Do not use until the TiDB installation and
# exact provisioning commands have been separately approved.
APP_NAME="KPS V3 TiDB Test (Fake)"
APP_ENV=local
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8002
FRONTEND_URL=http://127.0.0.1:5175
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5175
KPS_DATABASE_ENVIRONMENT=development
KPS_V3_TIDB_TEST_ENABLED=true
KPS_V3_TIDB_PINNED_VERSION=v8.5.8

DB_CONNECTION=mysql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=4000
DB_DATABASE=kps_v3_phase7b1_local
DB_USERNAME=kps_v3_phase7b1
DB_PASSWORD=replace-with-a-random-local-only-password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

WEEKLY_PLAN_WORKFLOW_V3_ENABLED=true
WEEKLY_PLAN_STORAGE_DISK=weekly_plan_e2e
FILESYSTEM_DISK=weekly_plan_e2e
WEEKLY_PLAN_DOCUMENT_AI_DRIVER=none
SESSION_DRIVER=database
CACHE_STORE=database
CACHE_PREFIX=kps_v3_tidb_test_
QUEUE_CONNECTION=sync
MAIL_MAILER=array
