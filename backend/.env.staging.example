APP_NAME="KPS Internal System API (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://kps-api-staging.example.invalid
FRONTEND_URL=https://kps-staging.example.invalid
SANCTUM_STATEFUL_DOMAINS=kps-staging.example.invalid

KPS_DATABASE_ENVIRONMENT=staging

REPORT_TIMEZONE=Asia/Ho_Chi_Minh
REPORT_CUTOFF_TIME=23:00
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_URL=
DB_HOST=staging-tidb.example.invalid
DB_PORT=4000
DB_DATABASE=kps_internal
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log

FILESYSTEM_DISK=local
WEEKLY_PLAN_STORAGE_DISK=local
KPS_STAGING_EPHEMERAL_FILES=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ROOT_PREFIX=weekly-planning

WEEKLY_PLAN_DOCUMENT_AI_DRIVER=none
WEEKLY_PLAN_TIMEZONE=Asia/Ho_Chi_Minh
WEEKLY_PLAN_MAX_FILE_KB=5120
WEEKLY_PLAN_MAX_ARCHIVE_ENTRIES=250
WEEKLY_PLAN_MAX_UNCOMPRESSED_BYTES=52428800
WEEKLY_PLAN_MAX_COMPRESSION_RATIO=100
WEEKLY_PLAN_MAX_ROWS=1000
WEEKLY_PLAN_MAX_SHEETS=10
WEEKLY_PLAN_MAX_SOURCE_PASSAGES=500
WEEKLY_PLAN_MAX_SOURCE_CHARACTERS=200000
WEEKLY_PLAN_MAX_SOURCE_PASSAGE_CHARACTERS=10000
WEEKLY_PLAN_MAX_SOURCE_PASSAGES_PER_ENTRY=20
WEEKLY_PLAN_MAX_SOURCE_ENTRIES_PER_REQUEST=20
WEEKLY_PLAN_AI_MAX_PASSAGES=200
WEEKLY_PLAN_AI_MAX_CONTEXT_BYTES=60000
WEEKLY_PLAN_AI_MAX_TASKS_PER_RESPONSE=20
WEEKLY_PLAN_AI_MAX_ITEMS_PER_TASK=20
WEEKLY_PLAN_AI_MAX_TOTAL_ITEMS_PER_RESPONSE=100
WEEKLY_PLAN_AI_MAX_OUTPUT_TOKENS=6000
WEEKLY_PLAN_AI_REASONING_EFFORT=low
# Render Secret File path; never place the JSON value itself in an environment variable.
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_PATH=/etc/secrets/kps-google-service-account.json
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_MAX_BYTES=65536
GOOGLE_DOCS_TIMEOUT_SECONDS=15
GOOGLE_DOCS_MAX_RESPONSE_BYTES=5242880
GOOGLE_DRIVE_METADATA_MAX_RESPONSE_BYTES=65536
GOOGLE_DOCS_PREVIEW_PER_MINUTE=4

KPS_AI_DRIVER=fake
KPS_AI_MODEL=gpt-6-luna
# Enable WEEKLY_PLAN_DOCUMENT_AI_DRIVER=openai only after all gateway values below are set.
KPS_AI_MONTHLY_BUDGET_USD=10.00
KPS_AI_INPUT_USD_PER_MILLION_TOKENS=0
KPS_AI_OUTPUT_USD_PER_MILLION_TOKENS=0
KPS_AI_TIMEOUT_SECONDS=60
KPS_AI_CONNECT_TIMEOUT_SECONDS=10
KPS_AI_MAX_ATTEMPTS=2
KPS_AI_RETRY_DELAY_MS=250
KPS_AI_MAX_RETRY_DELAY_MS=2000
KPS_AI_STALE_AFTER_SECONDS=180
KPS_AI_MAX_INPUT_BYTES=65000
KPS_AI_MAX_INPUT_TOKENS=65000
KPS_AI_MAX_OUTPUT_TOKENS=6000
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
