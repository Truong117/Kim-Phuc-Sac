# Copy selected values into a dedicated local process environment.
# Never copy this file over backend/.env and never point it at existing data.
APP_NAME="KPS V3 E2E (Fake)"
APP_ENV=local
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8001
FRONTEND_URL=http://127.0.0.1:5174
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5174
KPS_DATABASE_ENVIRONMENT=development
KPS_V3_E2E_TEST_ENABLED=true

DB_CONNECTION=sqlite
DB_URL=
DB_DATABASE=storage/framework/testing/weekly-plan-v3-e2e/database/weekly-plan-v3-e2e.sqlite
DB_FOREIGN_KEYS=true

WEEKLY_PLAN_WORKFLOW_V3_ENABLED=true
WEEKLY_PLAN_STORAGE_DISK=weekly_plan_e2e
FILESYSTEM_DISK=weekly_plan_e2e
WEEKLY_PLAN_DOCUMENT_AI_DRIVER=none

SESSION_DRIVER=database
SESSION_COOKIE=kps_v3_e2e_session
CACHE_STORE=database
CACHE_PREFIX=kps_v3_e2e_
QUEUE_CONNECTION=sync
MAIL_MAILER=array
LOG_CHANNEL=weekly_plan_e2e
LOG_DEPRECATIONS_CHANNEL=null
