APP_NAME="KPS Internal System API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Runtime safety checks are mandatory; there is no opt-out flag.
KPS_DATABASE_ENVIRONMENT=development
KPS_ALLOW_REMOTE_DATABASE=false
KPS_EXPECTED_DATABASE_HOST=
KPS_EXPECTED_DATABASE_NAME=

REPORT_TIMEZONE=Asia/Ho_Chi_Minh
REPORT_CUTOFF_TIME=23:00

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_URL=
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

# To use a dedicated local MySQL database, replace only the DB_* values above.
# Never copy staging or production credentials into a development .env.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kps_internal_local
# DB_USERNAME=kps_local
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
WEEKLY_PLAN_STORAGE_DISK=local
WEEKLY_PLAN_DOCUMENT_AI_DRIVER=none
WEEKLY_PLAN_TIMEZONE=Asia/Ho_Chi_Minh
WEEKLY_PLAN_MAX_FILE_KB=5120
WEEKLY_PLAN_MAX_ARCHIVE_ENTRIES=250
WEEKLY_PLAN_MAX_UNCOMPRESSED_BYTES=52428800
WEEKLY_PLAN_MAX_COMPRESSION_RATIO=100
WEEKLY_PLAN_MAX_ROWS=1000
WEEKLY_PLAN_MAX_SHEETS=10
WEEKLY_PLAN_MAX_SOURCE_PASSAGES=500
WEEKLY_PLAN_MAX_SOURCE_CHARACTERS=200000
WEEKLY_PLAN_MAX_SOURCE_PASSAGE_CHARACTERS=10000
WEEKLY_PLAN_MAX_SOURCE_PASSAGES_PER_ENTRY=20
WEEKLY_PLAN_MAX_SOURCE_ENTRIES_PER_REQUEST=20
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ROOT_PREFIX=

VITE_APP_NAME="${APP_NAME}"

# KPS AI Daily Report V1 (fake = no external API calls)
KPS_AI_DRIVER=fake
KPS_AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
