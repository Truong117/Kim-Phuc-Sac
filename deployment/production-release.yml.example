# Preparation template only. This is outside .github/workflows and cannot run.
# Activation requires a reviewed Production executor and DB inspector. Never copy
# Staging DB credentials/runner to Production. See docs/CI_CD_RUNBOOK.md.
name: Production release (activation candidate)
on:
  push:
    branches: [main]
permissions:
  contents: read
concurrency:
  group: kps-release
  cancel-in-progress: false
jobs:
  checks:
    uses: ./.github/workflows/ci.yml
  production:
    needs: checks
    environment: production
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: node deployment/check-production-baseline.mjs
      - name: Activation guard
        run: |
          echo 'STOP: implement and review Production DB identity/schema/backup gates, reuse the durable release lock, then backend → frontend → business smoke. No Production executor is enabled in phase 1.'
          exit 1
